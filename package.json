{
  "name": "@tigerdata/tiger-gh-mcp-server",
  "version": "0.1.0",
  "description": "MCP server to pull status from GitHub",
  "license": "UNLICENSED",
  "author": "TigerData",
  "homepage": "https://tigerdata.com",
  "type": "module",
  "bin": {
    "tiger-gh-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "check": "./bun i --silent && ./bun --silent run typecheck && ./bun --silent run lint --write",
    "inspector": "./bun x @modelcontextprotocol/inspector",
    "lint": "biome check",
    "prepublishOnly": "./bun run build",
    "start": "./bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "watch": "./bun --watch src/index.ts"
  },
  "dependencies": {
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@tigerdata/mcp-boilerplate": "^1.5.0",
    "dotenv": "^17.4.2",
    "migrate": "^2.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  }
}
