{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Github MCP",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/bun",
      "program": "${workspaceFolder}/src/index.ts",
      "args": ["http"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "development"
      },
      "presentation": {
        "group": "mcp",
        "order": 1
      }
    }
  ]
}
