{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Github MCP",
      "type": "bun",
      "request": "launch",
      "runtime": "${workspaceFolder}/bun",
      "program": "${workspaceFolder}/src/index.ts",
      "args": [
        "http"
      ],
      "cwd": "${workspaceFolder}",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "NODE_ENV": "development",
        "PORT": "5562"
      },
      "presentation": {
        "group": "mcp",
        "order": 1
      }
    }
  ]
}