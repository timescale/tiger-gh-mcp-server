{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: install",
      "type": "shell",
      "command": "./bun install",
      "group": "build",
      "detail": "Install project dependencies",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "bun: build",
      "type": "shell",
      "command": "./bun run build",
      "group": "build",
      "detail": "Build the project",
      "dependsOn": "bun: install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Debug Github MCP - Build Only",
      "dependsOrder": "sequence",
      "dependsOn": ["bun: install", "bun: build"],
      "group": "build"
    }
  ]
}
